# Day23：环境变量样例。复制为 .env 后按需修改，.env 本身不要提交到版本库。
# 这里的每一项都对应 docker-compose.yml 或 application.yml 中的占位符，
# 目的是让依赖可以"由非个人凭据的配置启动"——换台机器换个人都能跑。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=cloud_drive
MYSQL_USER=clouddrive
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---- 应用运行时（与上面保持一致）----
# 本机开发保持默认 profile，不解析转发头。仅同机 Nginx 部署时启用：
# SPRING_PROFILES_ACTIVE=deploy
# deploy 将后端绑定 127.0.0.1，只信任本机代理；必须使用配套 Nginx 头覆盖规则。
CLOUD_DRIVE_DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_drive?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
CLOUD_DRIVE_DB_USER=clouddrive
CLOUD_DRIVE_DB_PASSWORD=change-me-app
CLOUD_DRIVE_REDIS_HOST=127.0.0.1
CLOUD_DRIVE_REDIS_PORT=6379
CLOUD_DRIVE_REDIS_PASSWORD=change-me-redis

# JWT 对称密钥，HS256 要求至少 32 字节
CLOUD_DRIVE_JWT_SECRET=please-replace-with-a-long-random-secret-key
CLOUD_DRIVE_JWT_TTL_MINUTES=120

# 本地存储目录
CLOUD_DRIVE_STORAGE_ROOT=build-output/local-storage
CLOUD_DRIVE_CHUNK_ROOT=build-output/local-chunks
CLOUD_DRIVE_SNAPSHOT_PATH=build-output/snapshots/entries.txt

# ---- 集成测试（mvn test -DexcludedGroups= 时才需要）----
CLOUD_DRIVE_TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_drive_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
CLOUD_DRIVE_TEST_DB_USER=clouddrive
CLOUD_DRIVE_TEST_DB_PASSWORD=change-me-app
CLOUD_DRIVE_TEST_REDIS_HOST=127.0.0.1
CLOUD_DRIVE_TEST_REDIS_PORT=6379

# 智能分类 / 可选辅助审核
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
AI_MAX_TEXT_BYTES=24000
AI_REVIEW_ENABLED=false

# 邮箱验证码（SMTP 密码通常为邮箱授权码）
CLOUD_DRIVE_SMTP_HOST=
CLOUD_DRIVE_SMTP_PORT=587
CLOUD_DRIVE_SMTP_USERNAME=
CLOUD_DRIVE_SMTP_PASSWORD=
CLOUD_DRIVE_MAIL_FROM=
CLOUD_DRIVE_SMTP_AUTH=true
CLOUD_DRIVE_SMTP_STARTTLS=true
CLOUD_DRIVE_SMTP_SSL=false
CLOUD_DRIVE_MAIL_IP_LIMIT=20
CLOUD_DRIVE_MAIL_IP_WINDOW_SECONDS=600

# 首次创建管理员
CLOUD_DRIVE_ADMIN_USERNAME=
CLOUD_DRIVE_ADMIN_PASSWORD=
CLOUD_DRIVE_ADMIN_EMAIL=
