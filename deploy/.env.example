# Copy this file to deploy/.env and replace every password before deployment.
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_NAMESPACE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=base_project
DB_USERNAME=cloud_drive
DB_PASSWORD=replace_with_a_strong_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_password

FILE_STORAGE_PATH=/data/cloud-drive/files
CHUNK_STORAGE_PATH=/data/cloud-drive/chunks
CHUNK_EXPIRATION_DAYS=1

# Optional: only required when START_AI=true.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_CHAT_MODEL=deepseek-chat
