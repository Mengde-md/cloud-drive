# Copy this file to deploy/.env and fill in your own values.
# deploy/.env is git-ignored (see .gitignore: ".env"), so real credentials
# never get committed. Nothing in this repo hardcodes a personal password —
# both docker-compose.yml and the Spring Boot app read these same names.

# --- MySQL ---
CLOUDDRIVE_DB_NAME=cloud_drive_learning
CLOUDDRIVE_DB_USERNAME=clouddrive_app
CLOUDDRIVE_DB_PASSWORD=change-me
CLOUDDRIVE_DB_ROOT_PASSWORD=change-me-too
CLOUDDRIVE_DB_PORT=3306
# Full JDBC URL consumed by application.properties; host/port must match the
# compose service above (or your externally-run MySQL instance).
CLOUDDRIVE_DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_drive_learning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# --- Redis ---
CLOUDDRIVE_REDIS_HOST=127.0.0.1
CLOUDDRIVE_REDIS_PORT=6379
CLOUDDRIVE_REDIS_PASSWORD=change-me-as-well

# --- JWT ---
# Any sufficiently random string; do not reuse across environments.
CLOUDDRIVE_JWT_SECRET=change-me-to-a-real-secret

# --- Nacos (Day24) ---
# 控制台/OpenAPI 端口与 2.x gRPC 端口。9848 必须一起映射，否则控制台打得开、
# 客户端却一直注册超时。
CLOUDDRIVE_NACOS_PORT=8848
CLOUDDRIVE_NACOS_GRPC_PORT=9848
CLOUDDRIVE_NACOS_SERVER_ADDR=127.0.0.1:8848

# 服务端鉴权。NACOS_AUTH_TOKEN 必须是 base64 且解码后不少于 32 字节，否则 Nacos 启动即失败。
# 可以用：openssl rand -base64 48
CLOUDDRIVE_NACOS_AUTH_TOKEN=change-me-base64-at-least-32-bytes
CLOUDDRIVE_NACOS_IDENTITY_KEY=change-me-identity-key
CLOUDDRIVE_NACOS_IDENTITY_VALUE=change-me-identity-value

# 客户端登录用的控制台账号（首次启动后在 Nacos 控制台创建，默认 nacos/nacos 必须改掉）。
CLOUDDRIVE_NACOS_USERNAME=nacos
CLOUDDRIVE_NACOS_PASSWORD=change-me-too

# 配置隔离：namespace 分环境（留空=public，正式使用请在控制台建 dev/test/prod 三个
# namespace 并把 id 填进来），group 分业务域。
CLOUDDRIVE_NACOS_NAMESPACE=
CLOUDDRIVE_NACOS_GROUP=CLOUDDRIVE_GROUP

# --- 服务名与网关 (Day24) ---
# 单体进程注册到 Nacos 用的服务名，也是网关 lb:// 后面的目标名，两边必须一致。
CLOUDDRIVE_APP_NAME=cloud-drive-app
CLOUDDRIVE_GATEWAY_APP_NAME=cloud-drive-gateway
CLOUDDRIVE_GATEWAY_PORT=9000
# 默认形态（不用 Nacos 时）网关直接转发到的后端地址。
CLOUDDRIVE_APP_URI=http://127.0.0.1:8080
