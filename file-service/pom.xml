<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>base-project</artifactId>
        <groupId>com.base</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>file-service</artifactId>
    <name>文件服务</name>

    <dependencies>
        <dependency><groupId>com.base</groupId><artifactId>common</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
        <!--
            Caffeine 本地缓存（L1 级别）

            【为什么要引入 Caffeine？】
            - 两级缓存架构：L1(Caffeine) + L2(Redis)
            - L1 是进程内缓存，纳秒级访问速度，比 Redis 快 100 倍以上
            - 热点数据（如首页概览）会被频繁访问，Caffeine 可以大幅减少 Redis 网络开销
            - Caffeine 使用 W-TinyLFU 淘汰算法，命中率优于传统的 LRU

            【版本管理】
            - 版本号在父 pom.xml 的 properties 中统一管理（caffeine.version）
            - 这里不需要写 version 标签，由 dependencyManagement 控制
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>

        <!-- 单元测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Nacos 服务注册与发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Boot 3 需要用 bootstrap 配置，引入此依赖 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- OpenFeign 声明式 HTTP 客户端（用于跨服务调用 user-service） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Spring Cloud LoadBalancer（OpenFeign 和 Gateway 的 lb:// 都需要） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!--
            MapStruct 编译期对象映射（替代手动 BeanUtils.copyProperties）

            【面试知识点 —— MapStruct vs BeanUtils.copyProperties】
            - BeanUtils.copyProperties() 是运行时反射，每次调用都要通过反射 API 读写字段
            - MapStruct 是编译期代码生成，mvn compile 时直接生成 new + set 的 Java 源码
            - 性能差距：MapStruct 生成的代码和手写 getter/setter 一样快，比反射快 10~100 倍
            - 类型安全：字段名不匹配或类型不兼容时，MapStruct 在编译期就报错，BeanUtils 运行时默默跳过

            【为什么不需要写 version？】
            - 版本号在父 pom.xml 的 <dependencyManagement> 中统一管理（mapstruct.version）
            - annotation processor 也已在父 pom 的 maven-compiler-plugin 中配置好了
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- SpringDoc OpenAPI：Swagger UI API 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>
</project>
