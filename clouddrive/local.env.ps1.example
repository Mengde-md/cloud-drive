# 复制本文件为 local.env.ps1，填入你本机的真实值。
# local.env.ps1 已在 .gitignore 里，不会被提交——口令绝不入版本库。

$DbHost = '127.0.0.1'
$DbPort = '3306'
$DbName = 'cloud_drive'
$DbUser = 'root'
$DbPassword = '你的MySQL口令'

$RedisHost = '127.0.0.1'
$RedisPort = '6379'
$RedisPassword = ''        # 本机 Redis 没设口令就留空

# 本地开发用，部署到服务器时必须换成随机值（openssl rand -base64 48）
$JwtSecret = 'local-dev-only-secret-key-at-least-32-bytes-long'

# 文件智能分类：留空时按文件后缀分类；配置后会向 DeepSeek 发送文件名和有限文本摘录。
$env:DEEPSEEK_API_KEY = ''
$env:DEEPSEEK_MODEL = 'deepseek-flash'
$env:AI_REVIEW_ENABLED = 'false'

# 邮箱验证码：填写真实 SMTP 服务信息，密码通常是邮箱的 SMTP 授权码。
$env:CLOUD_DRIVE_SMTP_HOST = ''
$env:CLOUD_DRIVE_SMTP_PORT = '587'
$env:CLOUD_DRIVE_SMTP_USERNAME = ''
$env:CLOUD_DRIVE_SMTP_PASSWORD = ''
$env:CLOUD_DRIVE_MAIL_FROM = ''
$env:CLOUD_DRIVE_SMTP_AUTH = 'true'
$env:CLOUD_DRIVE_SMTP_STARTTLS = 'true'
$env:CLOUD_DRIVE_SMTP_SSL = 'false' # 若用 465 端口，一般设为 true 并关闭 STARTTLS
# 反向代理后可能共享来源地址；可按实际使用量调整发送限流。
$env:CLOUD_DRIVE_MAIL_IP_LIMIT = '20'
$env:CLOUD_DRIVE_MAIL_IP_WINDOW_SECONDS = '600'

# 首次创建管理员：三项一起配置，仅创建新账号，不会提升已存在的普通账号。
$env:CLOUD_DRIVE_ADMIN_USERNAME = ''
$env:CLOUD_DRIVE_ADMIN_PASSWORD = ''
$env:CLOUD_DRIVE_ADMIN_EMAIL = ''
