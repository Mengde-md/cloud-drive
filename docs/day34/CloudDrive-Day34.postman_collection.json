{
  "info": {
    "name": "CloudDrive Day34 Full Chain",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://127.0.0.1:9000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "otherUsername",
      "value": ""
    },
    {
      "key": "otherPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "contentBase64",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"token\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Register other",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{otherUsername}}\",\"password\":\"{{otherPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login other",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{otherUsername}}\",\"password\":\"{{otherPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"otherToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Anonymous download",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gateway}}/api/files/{{fileId}}/download"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Upload UTF8 text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-User-Id",
            "value": "999999"
          },
          {
            "key": "X-User-Role",
            "value": "ADMIN"
          }
        ],
        "url": "{{gateway}}/api/files/upload",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "displayName",
              "value": "day34-evidence.txt",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"fileId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{gateway}}/api/files/{{fileId}}/download"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Range",
            "value": "bytes=0-4"
          }
        ],
        "url": "{{gateway}}/api/files/{{fileId}}/download"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 206\",()=>pm.response.to.have.status(206));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Other owner",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          }
        ],
        "url": "{{gateway}}/api/files/{{fileId}}/download"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Explicit RAG import",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/ai/rag/documents",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"day34-evidence.txt\",\"contentBase64\":\"{{contentBase64}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"documentId\",pm.response.json().documentId);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Search",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/ai/rag/search",
        "body": {
          "mode": "raw",
          "raw": "{\"question\":\"How long are deleted files kept in the recycle bin?\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 No consent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/ai/agent/ask",
        "body": {
          "mode": "raw",
          "raw": "{\"question\":\"How long are deleted files kept in the recycle bin?\",\"allowExternalProcessing\":false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Other owner refuses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/ai/agent/ask",
        "body": {
          "mode": "raw",
          "raw": "{\"question\":\"How long are deleted files kept in the recycle bin?\",\"allowExternalProcessing\":true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"No evidence\",()=>pm.expect(pm.response.json().reason).to.eql(\"NO_EVIDENCE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Agent answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway}}/api/ai/agent/ask",
        "body": {
          "mode": "raw",
          "raw": "{\"question\":\"How long are deleted files kept in the recycle bin?\",\"allowExternalProcessing\":true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Same document\",()=>pm.expect(pm.response.json().citations[0].documentId).to.eql(pm.collectionVariables.get(\"documentId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 List after AI restart",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{gateway}}/api/ai/rag/documents"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"RAG restart empty\",()=>pm.expect(pm.response.json()).to.have.length(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Persistent download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{gateway}}/api/files/{{fileId}}/download"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
